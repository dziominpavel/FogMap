# Ключ Яндекс MapKit (Full 4.42.0). НЕ коммитить реальные ключи.
# Скопируйте local.properties.example -> local.properties и вставьте свой ключ.
MAPKIT_API_KEY=YOUR_API_KEY
# sdk.dir — путь к Android SDK на ТВОЕЙ машине, поправь под себя, например:
# sdk.dir=C\:\\Users\\<твое_имя>\\AppData\\Local\\Android\\Sdk
# (если задан ANDROID_HOME, эту строку можно вообще удалить)
sdk.dir=C\:\\Users\\<твое_имя>\\AppData\\Local\\Android\\Sdk
